TELEGRAM_BOT_TOKEN=          # From @BotFather
GITHUB_TOKEN=                # GitHub PAT (fine-grained) with Copilot access
DB_PATH=/app/data/openclaw.db
ADMIN_TELEGRAM_ID=           # Your Telegram user ID (numeric)
DEFAULT_TIMEZONE=Australia/Melbourne
SUGGESTION_CRON=0 8 * * *
GITHUB_REPO_URL=             # Your repo URL for self-update

# Google Integration (optional — run /google in Telegram to connect)
GOOGLE_CLIENT_ID=            # From Google Cloud Console → OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=        # From Google Cloud Console → OAuth 2.0 Client Secret
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GOOGLE_TOKEN_PATH=./data/google-token.json

# Morning Digest
MORNING_DIGEST_CRON=30 6 * * *  # 6:30am daily (in your timezone)
GROUP_CHAT_ID=                   # Telegram group chat ID (get from bot logs or @raw_data_bot)
OPENWEATHER_API_KEY=             # Free key from https://openweathermap.org/api
WEATHER_LOCATION=Melbourne,AU

LOG_LEVEL=info
